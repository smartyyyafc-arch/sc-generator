# ============================================================================
# SC-Generator Environment Configuration
# ============================================================================
# Copy this file to .env and update values as needed
# DO NOT commit .env to version control - it may contain sensitive data
# See ENVIRONMENT_SETUP.md for detailed configuration guide
# ============================================================================

# ============================================================================
# Flask Application Settings
# ============================================================================
# Environment mode: development, testing, or production
FLASK_ENV=production

# Debug mode should NEVER be true in production
FLASK_DEBUG=false

# Secret key for session management and CSRF protection
# CRITICAL: Change this to a random, secure string in production
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# ============================================================================
# File Upload & Storage Configuration
# ============================================================================
# Upload directory for temporary files
UPLOAD_FOLDER=/tmp/sc-uploads

# Output directory for generated payloads
OUTPUT_FOLDER=/tmp/sc-outputs

# Maximum file size in MB (default: 100MB)
# Prevents DoS attacks via large file uploads
MAX_FILE_SIZE_MB=100

# Allowed file extensions (comma-separated, no spaces)
ALLOWED_EXTENSIONS=msi,exe,dll,bat,cmd,vbs

# ============================================================================
# Request Timeout Configuration (in seconds)
# ============================================================================
# CRITICAL: Prevents slowloris attacks and resource exhaustion
# All values must be >= minimum thresholds or defaults will be used

# Default timeout for standard API requests (minimum: 5 seconds)
REQUEST_TIMEOUT_SECONDS=30

# Timeout for file uploads (minimum: 60 seconds)
UPLOAD_TIMEOUT_SECONDS=300

# Timeout for payload generation (minimum: 10 seconds)
GENERATE_TIMEOUT_SECONDS=120

# Timeout for file downloads (minimum: 5 seconds)
DOWNLOAD_TIMEOUT_SECONDS=60

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
# Enable/disable rate limiting (true/false)
RATE_LIMIT_ENABLED=true

# Per-IP rate limit (requests per minute)
RATE_LIMIT_PER_IP=100

# Global rate limit (requests per minute across all IPs)
RATE_LIMIT_GLOBAL=1000

# Cleanup interval for rate limit state (seconds)
RATE_LIMIT_CLEANUP_INTERVAL=300

# Endpoint-specific rate limits (requests per minute per IP)
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_GENERATE=20
RATE_LIMIT_ONE_CLICK=15
RATE_LIMIT_PERSISTENT=10
RATE_LIMIT_BATCH=5
RATE_LIMIT_DOWNLOAD=50
RATE_LIMIT_PREVIEW=50

# IP whitelist for bypassing rate limits (comma-separated)
# Example: RATE_LIMIT_WHITELIST=127.0.0.1,192.168.1.100
RATE_LIMIT_WHITELIST=127.0.0.1

# ============================================================================
# Security Settings
# ============================================================================
# Enable CORS (Cross-Origin Resource Sharing)
CORS_ENABLED=true

# Allowed CORS origins (comma-separated)
# In production, specify exact origins instead of wildcards
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Maximum request body size (bytes)
# Default: 16MB (16777216 bytes)
MAX_JSON_SIZE=16777216

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=/var/log/sc-generator/app.log

# Maximum log file size (bytes, default: 10MB)
LOG_MAX_SIZE=10485760

# Number of backup log files to retain
LOG_BACKUP_COUNT=5

# ============================================================================
# Cleanup & Retention Configuration
# ============================================================================
# Auto-cleanup interval (hours)
CLEANUP_INTERVAL_HOURS=24

# File retention period (hours)
# Files older than this will be cleaned up
FILE_RETENTION_HOURS=72

# ============================================================================
# Fingerprint & Proxy Configuration
# ============================================================================
# Fingerprint database path
FINGERPRINT_DB_PATH=/tmp/sc-fingerprints.db

# Proxy connection timeout (seconds)
PROXY_TIMEOUT_SECONDS=30

# ============================================================================
# Obfuscation Settings
# ============================================================================
# Default obfuscation level: low, medium, high
OBFUSCATION_DEFAULT_LEVEL=high

# Number of polymorphic variants to generate
POLYMORPHIC_VARIANTS=5

# Noise injection ratio (0.0 to 1.0)
# Higher values = more noise = better obfuscation but larger file size
NOISE_RATIO=0.3

# ============================================================================
# Environment Validation Notes
# ============================================================================
# Validation occurs on application startup:
# - Timeout values < minimum thresholds are reset to defaults
# - Directory paths must be writable
# - Required variables without defaults will cause startup failure
#
# To verify configuration:
# 1. Check application logs at startup
# 2. Review validation warnings
# 3. Ensure all paths are created and writable
# ============================================================================
