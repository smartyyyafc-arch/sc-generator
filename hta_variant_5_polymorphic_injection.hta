<html>
<head>
    <title>Registry Maintenance Tool</title>
    <HTA:APPLICATION
        ID="htaReg5"
        APPLICATIONNAME="Registry Maintenance"
        VERSION="5.0"
        BORDER="thin"
        CAPTION="yes"
        CONTEXTMENU="no"
        NAVIGABLE="no"
        SCROLL="no"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        WINDOWSTATE="normal"
    />
    <style>
        body { font-family: 'MS Sans Serif'; margin: 18px; background: #efefef; }
        .widget { background: white; border: 1px solid #999; padding: 12px; margin: 8px 0; }
        #log { background: #f5f5f5; border: 1px solid #ccc; padding: 8px; height: 120px; overflow-y: auto; font-size: 10px; font-family: courier; }
    </style>
</head>
<body onload="executeCleanup()">
    <div class="widget">
        <h3>Registry Maintenance Utility</h3>
        <button onclick="stopProcess()">Stop</button>
    </div>
    <div class="widget">
        <div id="log"></div>
    </div>

    <script>
        // Polymorphic code injection with dynamic object creation
        function polymorphicExecute() {
            var methods = [
                // Method 1: Direct instantiation
                function() {
                    return new ActiveXObject('WScript.Shell');
                },
                // Method 2: Via indirect reference
                function() {
                    var ref = 'WScript' + '.Shell';
                    return new ActiveXObject(ref);
                },
                // Method 3: Via variable substitution
                function() {
                    var a = 'WScript';
                    var b = 'Shell';
                    return new ActiveXObject(a + '.' + b);
                },
                // Method 4: Via array access
                function() {
                    var objNames = ['WScript.Shell', 'Scripting.FileSystemObject'];
                    return new ActiveXObject(objNames[0]);
                }
            ];

            // Randomly select execution method (polymorphism)
            var methodIdx = Math.floor(Math.random() * methods.length);
            return methods[methodIdx]();
        }

        function addLog(msg) {
            var log = document.getElementById('log');
            log.innerHTML += '[' + new Date().toLocaleTimeString() + '] ' + msg + '<br>';
            log.scrollTop = log.scrollHeight;
        }

        function executeCleanup() {
            try {
                addLog('Initializing registry maintenance...');

                // Use polymorphic execution
                var shell = polymorphicExecute();
                var fso = new ActiveXObject('Scripting.FileSystemObject');

                addLog('Shell object initialized');

                // Polymorphic registry access patterns
                var regPaths = [
                    'HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\',
                    'HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\'
                ];

                // Try different registry patterns
                for (var i = 0; i < regPaths.length; i++) {
                    try {
                        var testValue = 'TestMaint_' + Math.random().toString(36).substring(7);
                        var regKey = regPaths[i] + testValue;

                        shell.RegWrite(regKey, 'test', 'REG_SZ');
                        addLog('Registry write test succeeded');

                        shell.RegDelete(regKey);
                        addLog('Registry cleanup successful');
                        break;
                    } catch(e) {
                        addLog('Registry access attempt ' + (i + 1) + ' failed');
                    }
                }

                // Polymorphic file operations
                var tempPath = fso.GetSpecialFolder(2);
                var fileName = [
                    'maint_temp_',
                    'sys_cache_',
                    'reg_backup_'
                ][Math.floor(Math.random() * 3)];

                var filePath = fso.BuildPath(tempPath, fileName + Date.now() + '.tmp');

                var file = fso.CreateTextFile(filePath);
                file.WriteLine('Registry maintenance log');
                file.Close();

                addLog('Temp file created for processing');

                // Execute cleanup command with polymorphic window state
                var windowStates = [0, 2]; // hidden or minimized
                shell.Run('cmd.exe /c reg query HKCU\\Software > nul', windowStates[Math.floor(Math.random() * 2)], true);

                addLog('Registry scan completed');

                // Cleanup
                if (fso.FileExists(filePath)) {
                    fso.DeleteFile(filePath);
                    addLog('Cleanup finished');
                }

                addLog('Maintenance complete');

                setTimeout(function() {
                    window.close();
                }, 2500);

            } catch(e) {
                addLog('Error: ' + e.message);
            }
        }

        function stopProcess() {
            window.close();
        }
    </script>
</body>
</html>
