# ============================================================================
# SC-Generator Secure Environment Configuration
# SECURITY FIX #3: Template with validation and secure defaults
# ============================================================================
# CRITICAL SECURITY NOTES:
# 1. NEVER commit this file to version control
# 2. ALWAYS use this as a template - copy to .env and modify
# 3. Ensure restrictive file permissions (chmod 600 .env)
# 4. Rotate secrets regularly
# 5. Use strong, random values for all secrets
# 6. Validate all configuration on startup
# ============================================================================

# ============================================================================
# CRITICAL: Required Secrets - MUST be changed for production
# ============================================================================

# Flask SECRET_KEY: Must be a strong, random secret for session management
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# CRITICAL: Change this immediately - current value is only for development
SECRET_KEY=CHANGEME-USE_RANDOM_SECRET_key_value_here_min_32_chars

# ============================================================================
# Flask Application Settings
# ============================================================================

# Environment mode: MUST be 'production' for production deployments
# Allowed values: development, testing, production
FLASK_ENV=production

# Debug mode: MUST be 'false' in production (exposes sensitive information)
# Allowed values: true, false
FLASK_DEBUG=false

# Application entry point
FLASK_APP=app.py

# Server binding address (0.0.0.0 = all interfaces)
SERVER_HOST=0.0.0.0

# Server port (ensure not in privileged port range unless running as root)
SERVER_PORT=5000

# ============================================================================
# File Upload & Storage Configuration - VALIDATED INPUTS
# ============================================================================

# Upload directory for temporary files
# SECURITY: Directory must exist and be writable only by application user
UPLOAD_FOLDER=/tmp/sc-uploads

# Output directory for generated payloads
# SECURITY: Directory must exist and be writable only by application user
OUTPUT_FOLDER=/tmp/sc-outputs

# Maximum file size in MB (VALIDATED: 1-500)
# Prevents DoS attacks via large file uploads
# VALIDATION: If value < 1 or > 500, defaults to 100MB
MAX_FILE_SIZE_MB=100

# Allowed file extensions (VALIDATED: comma-separated, no spaces)
# SECURITY: Only whitelisted extensions accepted
# Prevent: file traversal, executable uploads
ALLOWED_EXTENSIONS=msi,exe,dll,bat,cmd,vbs

# ============================================================================
# Request Timeout Configuration - VALIDATED INPUTS (in seconds)
# ============================================================================
# CRITICAL: Prevents slowloris attacks and resource exhaustion
# All values are VALIDATED with minimum thresholds on startup
# If validation fails, defaults are used and warning is logged

# Default timeout for standard API requests
# VALIDATION: Minimum 5 seconds, default 30 seconds
REQUEST_TIMEOUT_SECONDS=30

# Timeout for file uploads
# VALIDATION: Minimum 60 seconds, default 300 seconds
UPLOAD_TIMEOUT_SECONDS=300

# Timeout for payload generation
# VALIDATION: Minimum 10 seconds, default 120 seconds
GENERATE_TIMEOUT_SECONDS=120

# Timeout for file downloads
# VALIDATION: Minimum 5 seconds, default 60 seconds
DOWNLOAD_TIMEOUT_SECONDS=60

# ============================================================================
# Rate Limiting Configuration - VALIDATED INPUTS
# ============================================================================

# Enable/disable rate limiting (CRITICAL for security)
# Allowed values: true, false
RATE_LIMIT_ENABLED=true

# Per-IP rate limit (requests per minute)
# VALIDATION: Minimum 10, default 100
RATE_LIMIT_PER_IP=100

# Global rate limit (requests per minute across all IPs)
# VALIDATION: Minimum 100, default 1000
RATE_LIMIT_GLOBAL=1000

# Cleanup interval for rate limit state (seconds)
# VALIDATION: Minimum 60, default 300
RATE_LIMIT_CLEANUP_INTERVAL=300

# Endpoint-specific rate limits (requests per minute per IP)
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_GENERATE=20
RATE_LIMIT_ONE_CLICK=15
RATE_LIMIT_PERSISTENT=10
RATE_LIMIT_BATCH=5
RATE_LIMIT_DOWNLOAD=50
RATE_LIMIT_PREVIEW=50

# IP whitelist for bypassing rate limits (comma-separated, no spaces)
# SECURITY: Only add trusted IPs (load balancers, monitoring systems)
# Example: RATE_LIMIT_WHITELIST=127.0.0.1,192.168.1.100
RATE_LIMIT_WHITELIST=127.0.0.1

# ============================================================================
# Security Settings - VALIDATED INPUTS
# ============================================================================

# Enable CORS (Cross-Origin Resource Sharing)
# SECURITY: Disable (false) unless frontend is on different domain
CORS_ENABLED=true

# Allowed CORS origins (comma-separated, no spaces)
# SECURITY: In production, NEVER use wildcards (*)
# Use exact origins only: http://localhost:3000,https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Maximum request body size (bytes)
# VALIDATION: Minimum 1MB, maximum 100MB, default 16MB
# SECURITY: Prevents DoS via large JSON payloads
MAX_JSON_SIZE=16777216

# ============================================================================
# Logging Configuration - VALIDATED INPUTS
# ============================================================================

# Log level (controls verbosity)
# Allowed values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# SECURITY: Use INFO or WARNING in production (DEBUG exposes sensitive data)
LOG_LEVEL=INFO

# Log file path (must be writable by application user)
# SECURITY: Ensure logs are stored securely and rotated regularly
LOG_FILE=/var/log/sc-generator/app.log

# Maximum log file size (bytes)
# VALIDATION: Minimum 1MB, default 10MB
LOG_MAX_SIZE=10485760

# Number of backup log files to retain
# VALIDATION: Minimum 1, default 5
LOG_BACKUP_COUNT=5

# ============================================================================
# Cleanup & Retention Configuration - VALIDATED INPUTS
# ============================================================================

# Auto-cleanup interval (hours)
# SECURITY: Regularly clean up temporary files
# VALIDATION: Minimum 1, default 24
CLEANUP_INTERVAL_HOURS=24

# File retention period (hours)
# Files older than this will be cleaned up
# VALIDATION: Minimum 24, default 72
FILE_RETENTION_HOURS=72

# ============================================================================
# Fingerprint & Proxy Configuration
# ============================================================================

# Fingerprint database path
FINGERPRINT_DB_PATH=/tmp/sc-fingerprints.db

# Proxy connection timeout (seconds)
# VALIDATION: Minimum 5, default 30
PROXY_TIMEOUT_SECONDS=30

# ============================================================================
# Obfuscation Settings
# ============================================================================

# Default obfuscation level
# Allowed values: low, medium, high
OBFUSCATION_DEFAULT_LEVEL=high

# Number of polymorphic variants to generate
# VALIDATION: Minimum 1, maximum 20
POLYMORPHIC_VARIANTS=5

# Noise injection ratio (0.0 to 1.0)
# Higher values = more noise = better obfuscation but larger file size
# VALIDATION: Must be between 0.0 and 1.0
NOISE_RATIO=0.3

# ============================================================================
# SECURITY VALIDATION CHECKLIST - VERIFY BEFORE DEPLOYMENT
# ============================================================================
# Before deploying to production, verify ALL of the following:
#
# [ ] SECRET_KEY is changed from default (min 32 chars, use secrets.token_urlsafe)
# [ ] FLASK_ENV is set to 'production'
# [ ] FLASK_DEBUG is set to 'false'
# [ ] LOG_LEVEL is set to 'INFO' or 'WARNING' (never DEBUG in prod)
# [ ] RATE_LIMIT_ENABLED is 'true'
# [ ] CORS_ORIGINS does not contain wildcards (*)
# [ ] All file paths (UPLOAD_FOLDER, OUTPUT_FOLDER, LOG_FILE) exist and are writable
# [ ] All timeout values are >= minimum thresholds
# [ ] Max file size is appropriate for your use case
# [ ] Log rotation is configured (LOG_MAX_SIZE, LOG_BACKUP_COUNT)
# [ ] File permissions on .env file are restricted (chmod 600)
# [ ] This file is NOT committed to version control
# [ ] Database backups are configured and tested
# [ ] Monitoring and alerting are in place
# [ ] Security logs are being reviewed regularly
#
# ============================================================================
# ENVIRONMENT VALIDATION NOTES
# ============================================================================
# Validation occurs on application startup (see app.py):
#
# 1. Timeout values < minimum thresholds are reset to defaults with WARNING
# 2. Directory paths must be writable (checked at startup)
# 3. Required variables without defaults cause startup FAILURE
# 4. All string values are trimmed of whitespace
# 5. Invalid values trigger detailed error messages in logs
#
# To verify configuration:
# 1. Check application logs at startup for validation warnings
# 2. Review STDERR output during container initialization
# 3. Ensure all paths are created with correct permissions
# 4. Test endpoints with curl or API client after startup
#
# ============================================================================
