# ============================================================================
# Docker Build Context Ignore File
# Excludes sensitive files and unnecessary build artifacts
# ============================================================================

# Version control
.git
.gitignore
.github

# Environment and secrets (CRITICAL - Never copy to image)
.env
.env.local
.env.*.local
.env.production.local
.env.test.local
*.pem
*.key
*.crt
.ssh
.aws

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
.project
.classpath
.c9/
*.sublime-project
*.sublime-workspace

# Node dependencies and build artifacts
node_modules/
dist/
build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Documentation
docs/
*.md
!README.md

# Test files
test/
tests/
*.test.js
*.spec.js
.mocharc.json

# CI/CD
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Docker files (don't copy docker files into build)
Dockerfile*
docker-compose*.yml
.dockerignore

# Generated files
*.egg-info/
dist/
build/

# OS-specific
Thumbs.db
Desktop.ini

# Local development
local/
temp/
tmp/
